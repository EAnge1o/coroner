{
    "name": "eangelo/coroner",
    "type": "project",
    "description": "MCP-powered forensics for Symfony Messenger failed messages",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.6",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/orm": "^3.8",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "1.0.0-BETA1",
        "symfony/ai-bundle": "1.0.0-BETA1",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/ai-ollama-platform": "1.0.0-BETA1",
        "symfony/console": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "^8.1",
        "symfony/mcp-bundle": "1.0.0-BETA1",
        "symfony/messenger": "^8.1",
        "symfony/process": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    }
}
